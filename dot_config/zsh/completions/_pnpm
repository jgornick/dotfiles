#compdef pnpm pn
# pnpm's own zsh completion, captured verbatim from `pnpm completion zsh`
# (pnpm 11.21.0) minus its leading #compdef line, which has to stay first here.
#
# Checked in rather than eval'd at startup: `eval "$(pnpm completion zsh)"`
# costs ~250ms per shell because pnpm is a proto shim. Nothing is lost by
# freezing it — the body below is a static tabtab shim that shells out to
# `pnpm completion-server` at completion time, so subcommands, package.json
# scripts and workspace names still come from the installed pnpm, and the
# shim itself doesn't change between pnpm releases.
#
# To regenerate, keep this header and replace everything below it with the
# output of:  pnpm completion zsh | sed 1d
###-begin-pnpm-completion-###
if type compdef &>/dev/null; then
  _pnpm_completion () {
    local reply
    local si=$IFS

    IFS=$'\n' reply=($(COMP_CWORD="$((CURRENT-1))" COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" SHELL=zsh pnpm completion-server -- "${words[@]}"))
    IFS=$si

    if [ "$reply" = "__tabtab_complete_files__" ]; then
      _files
    else
      _describe 'values' reply
    fi
  }
  # When called by the Zsh completion system, this will end with
  # "loadautofunc" when initially autoloaded and "shfunc" later on, otherwise,
  # the script was "eval"-ed so use "compdef" to register it with the
  # completion system
  if [[ $zsh_eval_context == *func ]]; then
    _pnpm_completion "$@"
  else
    compdef _pnpm_completion pnpm pn
  fi
fi
###-end-pnpm-completion-###

