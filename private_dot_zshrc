# zmodload zsh/zprof

# *******************************************************************************
# Development Environment Configuration
# *******************************************************************************

# Set this before loading anything that uses XDG paths.
export XDG_CONFIG_HOME="${HOME}/.config"

# Initialize Homebrew without spawning `brew shellenv` for every shell.
if [[ -z ${HOMEBREW_PREFIX+x} ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    export HOMEBREW_PREFIX=/opt/homebrew
  elif [[ -x /usr/local/bin/brew ]]; then
    export HOMEBREW_PREFIX=/usr/local
  else
    export HOMEBREW_PREFIX=/usr/local
  fi
fi

export HOMEBREW_CELLAR="${HOMEBREW_CELLAR:-${HOMEBREW_PREFIX}/Cellar}"
export HOMEBREW_REPOSITORY="${HOMEBREW_REPOSITORY:-${HOMEBREW_PREFIX}}"
typeset -U path
path=("${HOMEBREW_PREFIX}/bin" "${HOMEBREW_PREFIX}/sbin" $path)
export INFOPATH="${HOMEBREW_PREFIX}/share/info:${INFOPATH:-}"
if [[ -n ${MANPATH-} ]]; then
  export MANPATH="${HOMEBREW_PREFIX}/share/man:${MANPATH}"
fi

#
# Set Development Tooling Environment Variables
#

# proto — language runtime manager (node, ruby, python, go, rust, java, etc.)
export PROTO_HOME="${HOME}/.proto"
path=("${PROTO_HOME}/shims" "${PROTO_HOME}/bin" "${HOME}/.local/bin" $path)

# Gem executables from proto's ruby (e.g. cocoapods' pod) have no proto shim;
# appended so the shims above still win for ruby/gem/bundle
for gem_bin in "${PROTO_HOME}"/tools/ruby/*/bin(N); do
  path+=("${gem_bin}")
done
unset gem_bin

export NODE_OPTIONS="${NODE_OPTIONS} --max_old_space_size=4096"

# npm auth is machine-local state. Read it before the first command instead of
# spawning grep and sed during every shell startup.
_load_npm_auth() {
  add-zsh-hook -d preexec _load_npm_auth

  local line token="${NODE_AUTH_TOKEN-}"
  if [[ -z "${token}" && -r "${HOME}/.npmrc" ]]; then
    while IFS= read -r line; do
      case "${line}" in
        *_authToken=*) token="${line#*_authToken=}" ;;
      esac
    done < "${HOME}/.npmrc"
  fi

  if [[ -n "${token}" ]]; then
    export NODE_AUTH_TOKEN="${token}"
    export YARN_NPM_AUTH_IDENT="${token}"
    # For classic version of yarn as npm9_ doesn't support _auth in npmrc
    export npm_config__auth="${token}"
  else
    unset NODE_AUTH_TOKEN
  fi
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec _load_npm_auth

# Set Android paths
export ANDROID_HOME="${ANDROID_HOME:-"${HOMEBREW_PREFIX}/share/android-commandlinetools"}"
export ANDROID_SDK_ROOT="${ANDROID_HOME}"
path=(
  "${ANDROID_HOME}/emulator"
  "${ANDROID_HOME}/cmdline-tools/latest/bin"
  "${ANDROID_HOME}/platform-tools"
  $path
)

# Set the gradle path
export GRADLE_USER_HOME="${GRADLE_USER_HOME:-"${HOME}/.gradle"}"

# Set the default iOS simulator name
export IOS_SIMULATOR_NAME="iPhone 16 - iOS 26.5"

# Set the default Android emulator name
export ANDROID_AVD_NAME="pixel_9_api_36"

# *******************************************************************************
# END OF Development Environment Configuration
# *******************************************************************************

# User configuration

# No manual VS Code shell integration here: `terminal.integrated.shellIntegration.
# enabled` defaults to true, so VS Code injects it automatically. Sourcing it by
# hand spawned the `code` CLI on every start, which cost ~135ms — over half of
# shell startup inside VS Code. Re-add the line below if injection ever fails:
#   [[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"

export EDITOR="vim"

typeset ls_colors_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/ls-colors"
if [[ ! -r "${ls_colors_cache}" ]] && (( $+commands[vivid] )); then
  mkdir -p -- "${ls_colors_cache:h}" &&
    vivid generate catppuccin-mocha >| "${ls_colors_cache}" ||
    rm -f -- "${ls_colors_cache}"
fi
if [[ -r "${ls_colors_cache}" ]]; then
  IFS= read -r LS_COLORS < "${ls_colors_cache}"
  export LS_COLORS
fi
unset ls_colors_cache

# Keep enough history for interactive search across concurrent shell sessions.
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

ulimit -n 524288

# initialize antidote plugins statically with ${ZDOTDIR:-~}/.zsh_plugins.txt
source "${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh"
typeset zsh_compdump="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/zcompdump"
typeset zsh_plugins="${ZDOTDIR:-${HOME}}/.zsh_plugins.txt"
typeset zsh_plugins_static="${zsh_plugins:r}.zsh"
if [[ ! -r "${zsh_compdump}" ||
      "${zsh_plugins}" -nt "${zsh_compdump}" ||
      "${zsh_plugins_static}" -nt "${zsh_compdump}" ]]; then
  zstyle ':plugin:ez-compinit' use-cache no
  rm -f -- "${zsh_compdump}" "${zsh_compdump}.zwc"
else
  zstyle ':plugin:ez-compinit' use-cache yes
fi
unset zsh_compdump zsh_plugins zsh_plugins_static
zstyle ':antidote:bundle:jgornick/wtint' defer-options '-t 0.5'
antidote load
source "${XDG_CONFIG_HOME}/zsh/carapace.zsh"

# zsh-history-substring-search is loaded above through antidote.
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1

alias ..='cd ../'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

alias grep='grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn,.idea,.tox,.venv,venv}'
alias ls='ls -lAh --color'

# dotfiles + prefs sync via chezmoi
source "${XDG_CONFIG_HOME}/zsh/dots.zsh"

eval "$(starship init zsh)"

_dotfiles_proto_activate() {
  (( ${+_DOTFILES_PROTO_ACTIVATED} )) && return 0
  eval "$(proto activate zsh)" || return 1
  add-zsh-hook -d precmd proto_activate
  typeset -g _DOTFILES_PROTO_ACTIVATED=1
}

_dotfiles_worktrunk_activate() {
  (( ${+_DOTFILES_WORKTRUNK_ACTIVATED} )) && return 0
  (( $+commands[wt] )) || return 0
  eval "$(command wt config shell init zsh)" || return 1
  typeset -g _DOTFILES_WORKTRUNK_ACTIVATED=1
}

_dotfiles_proto_activate_before_command() {
  if _dotfiles_proto_activate; then
    add-zsh-hook -d preexec _dotfiles_proto_activate_before_command
  else
    print -ru2 -- 'zsh: proto activation failed'
  fi
}

# Defer Proto in a real terminal so it cannot delay the first prompt. The
# preexec fallback preserves runtime selection if the user types immediately;
# non-TTY shells activate eagerly for script compatibility.
if [[ -t 1 ]] && (( $+functions[zsh-defer] )); then
  add-zsh-hook preexec _dotfiles_proto_activate_before_command
  zsh-defer -2 -t 0.5 -c '_dotfiles_proto_activate'
else
  _dotfiles_proto_activate || print -ru2 -- 'zsh: proto activation failed'
fi

# Defer Worktrunk until zle is idle, but keep it usable before then.
if (( $+commands[wt] )); then
  wt() {
    unfunction wt
    _dotfiles_worktrunk_activate || return
    wt "$@"
  }

  if (( $+functions[zsh-defer] )); then
    zsh-defer -2 -t 0.5 -c '_dotfiles_worktrunk_activate'
  else
    _dotfiles_worktrunk_activate
  fi
fi

# Machine-local overrides and secrets (not managed by chezmoi)
[ -f "${HOME}/.zshrc.local" ] && source "${HOME}/.zshrc.local"

# zprof
